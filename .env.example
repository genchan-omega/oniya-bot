# このファイルを .env という名前でコピーして、値を入れてください。
# .env は .gitignore で Git の管理対象から外しています。

# Discord Developer Portal の Bot タブで発行した Token
DISCORD_TOKEN=

# DeepSeek Platform (https://platform.deepseek.com/api_keys) で作った API Key（sk- で始まる）
DEEPSEEK_API_KEY=

# 以下は省略可能（省略時は右の値）
# PROFILE=oniya               # 使う人格（profiles/ の下のディレクトリ名）
# DEEPSEEK_MODEL=deepseek-flash
# MAX_TOKENS=16384            # 1回の生成の最大トークン数
# MAX_CONTINUATIONS=3         # 上限で止まったときに続きを生成する回数
# CONTEXT_MAX=60              # 返事を作るときに渡す会話の履歴の上限。超えたら CONTEXT_KEEP 件まで一度に減らす
# CONTEXT_KEEP=30             # 履歴を減らすときに残す、新しい発言の数
# CONVERSATION_TIMEOUT=600    # bot が返事をしないまま何秒たったら会話を終えるか
# LOG_RETENTION_DAYS=180      # 発言の記録を残す日数
# WEB_SEARCH=true             # Web 検索・URL 読み取りを使うか
# THINKING=false              # 考えてから答えるモード（遅くなるが複雑な質問に強い）
# TZ_NAME=Asia/Tokyo          # リマインダーや予定の時刻のタイムゾーン
# DATA_DIR=data               # データの保存先。Railway ではボリュームの場所（/data）を指定する
