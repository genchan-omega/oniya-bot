# このファイルを .env という名前でコピーして、値を入れてください。
# .env は .gitignore で Git の管理対象から外しています。

# Discord Developer Portal の Bot タブで発行した Token
DISCORD_TOKEN=

# DeepSeek Platform (https://platform.deepseek.com/api_keys) で作った API Key（sk- で始まる）
DEEPSEEK_API_KEY=

# 以下は省略可能（省略時は右の値）
# DEEPSEEK_MODEL=deepseek-flash
# MAX_TOKENS=1024
# HISTORY_TURNS=10
# SYSTEM_PROMPT=あなたはDiscordサーバーで質問に答える親切なアシスタントです。日本語で簡潔に答えてください。
